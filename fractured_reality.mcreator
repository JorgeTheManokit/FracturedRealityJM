  "workspaceSettings": {
    "modid": "fractured_reality",
    "modName": "Fractured Reality",
    "version": "1.2.0",
    "description": "As reality breaks and the sky cracks apart, mysterious beings are unleashed upon the world. The cycle of day and night breaks, the rain disappears, and the mobs spawn less and less. The players have to shelter from the gravity fluctuations pulling them up into the sky. It is up to the players to solve what happened and fix their world. The players will have to solve puzzles and find a way to go above and beyond. Once the world is repaired, everything will go back to normal, but not for long. ",
    "author": "Jorge M.",
    "websiteURL": "https://modrinth.com/project/vZ2PEXzS",
    "license": "MIT License",
    "serverSideOnly": false,
    "modPicture": "logo",
    "requiredMods": [],
    "dependencies": [],
    "dependants": [],
    "mcreatorDependencies": [
      "jei"
    ],
    "currentGenerator": "neoforge-1.21.1",
    "credits": "Presenter, Moonbreaker \u0026 Faceless voicelines by https://www.youtube.com/@MIAparadisetv",
    "modElementsPackage": "net.starseer.fracturedreality"
  },
  "mcreatorVersion": 202500345720
}